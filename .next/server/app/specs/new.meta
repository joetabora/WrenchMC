{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/specs/layout,_N_T_/specs/new/layout,_N_T_/specs/new/page,_N_T_/specs/new"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/specs/new/__PAGE__",
    "/specs/new",
    "/specs",
    "/_index",
    "/_head"
  ]
}