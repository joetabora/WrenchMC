// WrenchMC Goliath - Comprehensive Harley Maintenance Database
// Prisma schema for Vercel Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are configured in prisma.config.ts (Prisma 7 requirement)
}

// User accounts (NextAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  profile       UserProfile?
  specs         Spec[]
  votes         SpecVote[]
  posts         ForumPost[]
  postReplies   ForumPostReply[]
  tutorials     Tutorial[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("user") // user, moderator, admin
  verified      Boolean   @default(false)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User profiles with bike info
model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bikeYear    String?
  bikeModel   String?
  bikeVariant String?
  bio         String?  @db.Text
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Harley models catalog
model HarleyModel {
  id          String   @id @default(cuid())
  name        String   // e.g., "Road King", "Softail"
  variant     String?  // e.g., "Classic", "Custom"
  yearStart   Int
  yearEnd     Int?
  engineType  String?  // e.g., "Twin Cam", "Milwaukee-Eight"
  displacement String? // e.g., "103ci", "114ci"
  description String?  @db.Text
  imageUrl    String?
  specs       Spec[]
  tutorials   Tutorial[]
  posts       ForumPost[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, variant, yearStart])
  @@index([name, yearStart])
}

// Technical specifications
model Spec {
  id              String   @id @default(cuid())
  componentName  String
  boltSize        String?
  torqueSpecLow   Float?
  torqueSpecHigh  Float?
  sequenceNotes   String?  @db.Text
  applicableYears Int[]    @default([])
  applicableModels String[] @default([])
  submittedBy     String
  user            User     @relation(fields: [submittedBy], references: [id])
  modelId         String?
  model           HarleyModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  approved        Boolean  @default(false)
  sourceNotes     String?  @db.Text
  sourceUrl       String?
  votes           SpecVote[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  viewCount       Int      @default(0)
  verified        Boolean  @default(false) // Community verified

  @@index([componentName])
  @@index([approved])
  @@index([submittedBy])
  @@index([modelId])
  // Fulltext search can be implemented at application level or with PostgreSQL extensions
}

// Votes on specs
model SpecVote {
  id        String   @id @default(cuid())
  specId    String
  spec      Spec     @relation(fields: [specId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  up        Boolean
  createdAt DateTime @default(now())

  @@unique([specId, userId])
  @@index([specId])
}

// YouTube tutorials
model Tutorial {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  youtubeId     String
  channelName   String?
  channelId     String?
  duration      Int?     // seconds
  thumbnailUrl  String?
  viewCount     Int      @default(0)
  likeCount     Int      @default(0)
  applicableModels String[] @default([])
  applicableYears Int[]   @default([])
  tags          String[] @default([])
  difficulty    String?  // beginner, intermediate, advanced
  submittedBy   String?
  user          User?    @relation(fields: [submittedBy], references: [id], onDelete: SetNull)
  modelId       String?
  model         HarleyModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  approved      Boolean  @default(true)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([youtubeId])
  @@index([approved, featured])
  @@index([modelId])
  // Fulltext search can be implemented at application level or with PostgreSQL extensions
}

// Community forum posts
model ForumPost {
  id            String   @id @default(cuid())
  title         String
  content       String   @db.Text
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  modelId       String?
  model         HarleyModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  tags          String[] @default([])
  viewCount     Int      @default(0)
  replyCount    Int      @default(0)
  pinned        Boolean  @default(false)
  locked        Boolean  @default(false)
  replies       ForumPostReply[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorId])
  @@index([modelId])
  @@index([pinned, createdAt])
  // Fulltext search can be implemented at application level or with PostgreSQL extensions
}

// Forum post replies
model ForumPostReply {
  id        String   @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?  // For nested replies
  parent    ForumPostReply? @relation("ReplyReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ForumPostReply[] @relation("ReplyReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
}

// Vector embeddings for RAG (stored separately, but tracked here)
model Embedding {
  id        String   @id @default(cuid())
  content   String   @db.Text
  sourceType String  // "spec", "manual", "tutorial", "forum"
  sourceId  String?
  vectorId  String?  // Pinecone vector ID
  metadata  Json?    // Additional metadata
  createdAt DateTime @default(now())

  @@index([sourceType, sourceId])
}

// AI query history (for analytics and caching)
model QueryHistory {
  id        String   @id @default(cuid())
  query     String   @db.Text
  normalizedQuery String? // Normalized version for matching (lowercase, trimmed)
  userId    String?
  response  String?  @db.Text
  sources   String[] @default([])
  specs     Json?    // Store related specs as JSON
  youtubeVideos Json? // Store related videos as JSON
  success   Boolean  @default(true)
  viewCount Int      @default(0) // Track how many times this answer was used
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([normalizedQuery]) // Index for fast query matching
}

// Part finder cache
model Part {
  id          String   @id @default(cuid())
  partNumber  String?
  name        String
  description String?  @db.Text
  manufacturer String?
  price       Float?
  currency    String?  @default("USD")
  url         String?
  applicableModels String[] @default([])
  applicableYears Int[] @default([])
  imageUrl    String?
  inStock     Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([partNumber])
  @@index([name])
  // Fulltext search can be implemented at application level or with PostgreSQL extensions
}
